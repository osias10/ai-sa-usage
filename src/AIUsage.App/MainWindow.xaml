<Window x:Class="AIUsage.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="AI SA" Icon="Assets/AISA.ico" Style="{StaticResource {x:Type Window}}"
 Width="240" Height="64" MinWidth="200" MinHeight="44"
 WindowStyle="None" ResizeMode="CanResizeWithGrip" AllowsTransparency="True" Background="Transparent"
 ShowInTaskbar="False" WindowStartupLocation="Manual" UseLayoutRounding="True" SnapsToDevicePixels="True"
 AutomationProperties.Name="AI SA 사용량 위젯">
 <Window.ContextMenu>
  <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
   Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" FontSize="11">
   <MenuItem Header="설정" Command="{Binding SettingsCommand}" InputGestureText="두 번 클릭" />
   <MenuItem Header="새로고침" Command="{Binding RefreshAllCommand}" InputGestureText="F5" />
   <MenuItem Header="크기 맞춤" Click="FitContentClicked" />
   <Separator />
   <MenuItem Header="숨기기" Command="{Binding HideCommand}" InputGestureText="Esc" />
  </ContextMenu>
 </Window.ContextMenu>
 <Window.Resources>
  <Style x:Key="CompactAction" TargetType="Button">
   <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
   <Setter Property="Background" Value="Transparent" />
   <Setter Property="BorderThickness" Value="0" />
   <Setter Property="Padding" Value="4,2" />
   <Setter Property="FontSize" Value="9" />
   <Setter Property="Cursor" Value="Hand" />
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="ActionBorder" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ActionBorder" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ActionBorder" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>
 <Border Margin="4" Background="{DynamicResource WidgetBrush}" BorderBrush="{DynamicResource BorderBrush}"
  BorderThickness="1" CornerRadius="7" MouseLeftButtonDown="DragWidget"
  ToolTip="두 번 클릭: 설정 · 마우스 오른쪽 버튼: 메뉴">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0" Focusable="False">
   <StackPanel x:Name="WidgetContent">
    <TextBlock Text="데모" FontSize="8" Foreground="{DynamicResource MutedBrush}" Margin="8,3,8,0"
     Visibility="{Binding IsDemo, Converter={StaticResource BoolVisibility}}" />
    <Button Style="{StaticResource CompactAction}" Command="{Binding SettingsCommand}" HorizontalContentAlignment="Left"
     Margin="4,3,4,0" ToolTip="{Binding Error}" Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}">
     <StackPanel Orientation="Horizontal">
      <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" />
      <TextBlock Text="확인 필요" FontSize="9" Foreground="{DynamicResource WarningBrush}" Margin="5,0,0,0" />
     </StackPanel>
    </Button>
    <ItemsControl ItemsSource="{Binding PinnedAccounts}">
     <ItemsControl.ItemTemplate>
      <DataTemplate>
       <Border Padding="8,6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Background="Transparent">
        <StackPanel>
        <Grid MinHeight="24">
         <Grid.ColumnDefinitions><ColumnDefinition Width="57" /><ColumnDefinition Width="5" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
         <Grid VerticalAlignment="Center">
          <Grid.ToolTip>
           <StackPanel MaxWidth="280">
            <TextBlock Text="{Binding ProviderName}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Alias}" />
            <TextBlock Text="{Binding DisplayDescription}" Margin="0,5,0,0" />
            <TextBlock Text="{Binding StateLabel}" Margin="0,5,0,0" />
            <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Visibility="{Binding HasNotice, Converter={StaticResource BoolVisibility}}" />
            <TextBlock Text="{Binding UpdatedLabel}" Margin="0,5,0,0" />
           </StackPanel>
          </Grid.ToolTip>
          <Grid.ColumnDefinitions><ColumnDefinition Width="12" /><ColumnDefinition Width="5" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Path Data="{Binding IconGeometry}" Width="12" Height="12" Stretch="Uniform" Fill="{DynamicResource TextBrush}" VerticalAlignment="Center" />
          <StackPanel Grid.Column="2" VerticalAlignment="Center">
           <TextBlock Text="{Binding ProviderName}" FontSize="9" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
           <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Alias}" FontSize="8" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1" Text="잔여" FontSize="7" Foreground="{DynamicResource MutedBrush}" Margin="3,1,0,0"
             Visibility="{Binding ShowRemaining, Converter={StaticResource BoolVisibility}}" />
           </Grid>
          </StackPanel>
          <TextBlock x:Name="AccountStatusIcon" Text="{Binding StatusIcon}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="8" Foreground="{Binding StateBrush}"
           HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-5" Visibility="{Binding HasStatusIndicator, Converter={StaticResource BoolVisibility}}"
           ToolTip="{Binding Notice}" AutomationProperties.Name="{Binding StateLabel}" />
         </Grid>
         <StackPanel Grid.Column="2" VerticalAlignment="Center">
          <ItemsControl ItemsSource="{Binding CompactWindows}">
           <ItemsControl.ItemTemplate>
            <DataTemplate>
             <Grid Height="20" ToolTip="{Binding DisplayDetail}" AutomationProperties.Name="{Binding Name}">
              <Grid.RowDefinitions><RowDefinition Height="17" /><RowDefinition Height="3" /></Grid.RowDefinitions>
              <Grid.ColumnDefinitions><ColumnDefinition Width="39" /><ColumnDefinition Width="37" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding CompactName}" FontSize="9" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
              <TextBlock Grid.Column="1" Text="{Binding Percent}" FontSize="11" FontWeight="Medium" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" HorizontalAlignment="Right" ToolTip="{Binding DisplayDetail}" />
              <TextBlock Grid.Column="2" Text="{Binding CompactReset}" FontSize="9" Foreground="{DynamicResource MutedBrush}" Margin="5,0,0,0"
               Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
              <ProgressBar Grid.Row="1" Grid.ColumnSpan="3" Height="2" VerticalAlignment="Top"
               Value="{Binding Value, Mode=OneWay}" Foreground="{Binding Accent}" Background="{DynamicResource TrackBrush}"
               Visibility="{Binding HasValue, Converter={StaticResource BoolVisibility}}" IsHitTestVisible="False"
               AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding DisplayDetail}" />
             </Grid>
            </DataTemplate>
           </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Grid Height="20" Visibility="{Binding HasWindows, Converter={StaticResource InverseBoolVisibility}}">
           <TextBlock Text="{Binding StateLabel}" FontSize="9" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"
            Visibility="{Binding NeedsConnection, Converter={StaticResource InverseBoolVisibility}}" />
           <Button Style="{StaticResource CompactAction}" Content="연결" Command="{Binding ConnectCommand}" HorizontalAlignment="Right"
            Visibility="{Binding NeedsConnection, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="계정 연결" />
          </Grid>
          <Button Style="{StaticResource CompactAction}" Content="취소" Command="{Binding CancelCommand}" HorizontalAlignment="Right"
           Visibility="{Binding CanCancelConnection, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="계정 연결 취소" />
         </StackPanel>
        </Grid>
        <TextBlock x:Name="LastCheckedLabel" Text="{Binding CompactUpdatedLabel}" ToolTip="{Binding LastCheckedDetail}"
         Height="13" FontSize="8" LineHeight="13" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource MutedBrush}"
         TextAlignment="Right" TextTrimming="CharacterEllipsis" Visibility="{Binding ShowLastChecked, Converter={StaticResource BoolVisibility}}" />
        </StackPanel>
       </Border>
      </DataTemplate>
     </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Button Style="{StaticResource CompactAction}" Command="{Binding SettingsCommand}" Margin="8,7" Padding="3,3"
     Visibility="{Binding NoPins, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="표시할 계정 선택">
     <StackPanel Orientation="Horizontal">
      <TextBlock Text="AI SA" FontSize="10" FontWeight="SemiBold" />
      <TextBlock Text="계정 선택" FontSize="9" Foreground="{DynamicResource MutedBrush}" Margin="10,1,0,0" />
     </StackPanel>
    </Button>
   </StackPanel>
  </ScrollViewer>
 </Border>
</Window>
